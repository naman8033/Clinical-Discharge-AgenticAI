# =============================================================================
#  Agentic Discharge AI — Environment Variables Template
#  Copy this file to .env and configure for your local environment
# =============================================================================

# ── OmniRouter / LiteLLM LLM Gateway ──────────────────────────────────────────
# Base URL of your OmniRouter or OpenAI-compatible gateway (e.g. LiteLLM, Ollama)
OMNIROUTER_BASE_URL=http://localhost:20128/v1
OMNIROUTER_API_KEY=your_omnirouter_api_key_here

# Direct LLM endpoints used by LangChain agents
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your_llm_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
OMNIROUTER_DEFAULT_MODEL=vertex/gemini-2.0-flash
OMNIROUTER_FAST_MODEL=vertex/gemini-2.0-flash
OMNIROUTER_REASONING_MODEL=vertex/gemini-2.5-flash
OMNIROUTER_PRO_MODEL=vertex/gemini-3.1-pro-preview
OMNIROUTER_EMBEDDING_MODEL=gemini/gemini-embedding-001

# LiteLLM Gateway Configuration
LITELLM_DEFAULT_MODEL=vertex/gemini-2.0-flash
LITELLM_TURBO_MODEL=vertex/gemini-2.5-flash
LITELLM_GATEWAY_PORT=4000
LITELLM_MASTER_KEY=your_litellm_master_key_here

# Routing Priority: "cost", "speed", or "quality"
LLM_COST_MODE=cost

# ── Mock EHR Server ───────────────────────────────────────────────────────────
# Base URL for the mock Electronic Health Records FastAPI service
MOCK_EHR_BASE_URL=http://localhost:8001
